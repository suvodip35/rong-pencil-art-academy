---
import Layout from '../../layouts/Layout.astro';

const response = await fetch('https://client-directus.siliconpin.in/items/artist?filter[status][_eq]=published&filter[artist_type][_eq]=junior')
const artistsData = await response.json()
const artists = artistsData.data
---

<Layout title="Junior Artists - Rong Pencil Art Academy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Junior Artists</h1>
      <p class="text-xl text-gray-600">Meet our talented and promising junior artists</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {artists.map((artist: any) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="relative">
            <img
              src={`https://client-directus.siliconpin.in/assets/${artist.img}`}
              alt={artist.name}
              class="w-full h-72 object-cover"
            />
            <div class="absolute top-4 right-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
              {artist.experience}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">{artist.name}</h3>
            <div class="space-y-2 text-gray-600 mb-4">
              <p><span class="font-semibold text-amber-700">Specialization:</span> {artist.specialization}</p>
              <p><span class="font-semibold text-amber-700">Experience:</span> {artist.experience} Years</p>
              <p><span class="font-semibold text-amber-700">Achievements:</span> {artist.achievements}</p>
            </div>
            <a href={`/artist/junior/${artist.id}`} class="inline-flex items-center bg-amber-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-amber-600 transition-colors">
              View Profile
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
