---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const artistResponse = await fetch('https://client-directus.siliconpin.in/items/artist?filter[status][_eq]=published&filter[artist_type][_eq]=guest');

  const artistData = await artistResponse.json();
  const artists = artistData.data || [];

  return artists.map((artist : any) => ({
    params: {id: artist.id.toString()},
    props: {artist},
  }));
}

const { artist } = Astro.props;
const { id } = Astro.params;
// console.log('artist', artist);
if (!id) {
  return Astro.redirect('/404');
}
---

<Layout 
  title={`${artist.name} - Guest Artist Profile - Rong Pencil Art Academy`}
  description={`Profile of guest artist ${artist.name} at Rong Pencil Art Academy. Specialization: ${artist.specialization}. Read about their experience, achievements, and notable works.`}
  keywords={`${artist.name}, guest artist, ${artist.specialization || 'fine art'}, art workshop mentor, Rong Pencil Art Academy`}
  ogImage={`https://client-directus.siliconpin.in/assets/${artist.img}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back Button -->
    <a href="/artist/guest" class="inline-flex items-center text-amber-600 hover:text-amber-700 mb-8 font-semibold">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Guest Artists
    </a>

    <!-- Artist Profile Header -->
    <div class="bg-gradient-to-r from-amber-50 via-white to-orange-50 rounded-3xl shadow-xl overflow-hidden mb-12 border border-amber-100">
      <div class="md:flex">

        {/* Artist Image */}
        <div class="md:w-1/3 p-6">
          <div class="overflow-hidden rounded-2xl shadow-lg">
            <img
              src={`https://client-directus.siliconpin.in/assets/${artist.img}`}
              alt={artist.name}
              class="w-full h-[450px] object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        {/* Artist Details */}
        <div class="md:w-2/3 p-8 lg:p-12">

          <div class="flex flex-wrap items-center gap-3 mb-4">
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">
              {artist.name}
            </h1>

            <span class="bg-amber-100 text-amber-700 px-4 py-1 rounded-full text-sm font-semibold">
              Professional Artist
            </span>
          </div>

          <p class="text-gray-600 text-lg mb-8">
            Experienced artist and mentor at Rong Pencil Art Academy.
          </p>

          {/* Stats */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Specialization</p>
              <p class="font-bold text-lg text-gray-900">
                {artist.specialization}
              </p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Experience</p>
              <p class="font-bold text-xl text-gray-900">
                {artist.experience} Years
              </p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Achievement</p>
              <p class="font-bold text-gray-900">
                {artist.achievements?.split(',')[0]}
              </p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Role</p>
              <p class="font-bold text-gray-900">
                Art Instructor
              </p>
            </div>

          </div>

          {/* Extra Details */}
          {
            artist.specialization && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">
                  Specialization:
                </span>
                <span class="ml-2 text-gray-700">
                  {artist.specialization}
                </span>
              </div>
            )
          }

          {
            artist.achievements && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">
                  Achievements:
                </span>
                <span class="ml-2 text-gray-700">
                  {artist.achievements}
                </span>
              </div>
            )
          }

          {
            artist.about && (
              <div class="mt-8 border-t pt-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  About Artist
                </h3>

                <p class="text-gray-600 leading-relaxed">
                  {artist.about}
                </p>
              </div>
            )
          }

        </div>

      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Notable Works Section -->
      {
        artist.notable_works && (
          <section class="bg-white rounded-2xl shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Notable Works</h2>
            <ul class="space-y-3">
          {artist.notable_works.split(',').map((work: string) => (
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">{work}</span>
            </li>
          ))}
        </ul>
          </section>
        )
      }

      <!-- Achievements Section -->
      {
        artist.achievements && (
          <section class="bg-white rounded-2xl shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Achievements</h2>
            <div class="space-y-4">
              {
                artist.achievements.split(',').map((achievement: string) => (
                  <div class="flex items-start">
                    <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <span class="text-gray-600">{achievement}</span>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }
      
    </div>
  </div>
</Layout>
