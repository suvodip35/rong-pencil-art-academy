---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const teacherResponse = await fetch('https://client-directus.siliconpin.in/items/teacher?filter[status][_eq]=published&filter[teacher_type][_eq]=school_teacher');

  const teacherData = await teacherResponse.json();
  const teachers = teacherData.data || [];

  return teachers.map((teacher : any) => ({
    params: {id: teacher.id.toString()},
    props: {teacher},
  }));
}

const { teacher } = Astro.props;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/404');
}
---

<Layout 
  title={`${teacher.name} - School Teacher Profile - Rong Pencil Art Academy`}
  description={`Meet school teacher and educator ${teacher.name} at Rong Pencil Art Academy. Subject: ${teacher.subject}. Experience: ${teacher.experience} years. Discover classes taught and achievements.`}
  keywords={`${teacher.name}, school teacher profile, drawing faculty, academic art instructor, ${teacher.subject || ''}`}
  ogImage={`https://client-directus.siliconpin.in/assets/${teacher.img}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back Button -->
    <a href="/teacher/school" class="inline-flex items-center text-amber-600 hover:text-amber-700 mb-8 font-semibold">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to School Teachers
    </a>

    <!-- Teacher Profile Header -->
    <div class="bg-gradient-to-r from-amber-50 via-white to-orange-50 rounded-3xl shadow-xl overflow-hidden mb-12 border border-amber-100">
      <div class="md:flex">

        {/* Teacher Image */}
        <div class="md:w-1/3 p-6">
          <div class="overflow-hidden rounded-2xl shadow-lg">
            <img
              src={`https://client-directus.siliconpin.in/assets/${teacher.img}`}
              alt={teacher.name}
              class="w-full h-[450px] object-cover hover:scale-105 transition duration-500"
            />
          </div>
        </div>

        {/* Teacher Details */}
        <div class="md:w-2/3 p-8 lg:p-12">

          <div class="flex flex-wrap items-center gap-3 mb-4">
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">{teacher.name}</h1>
            <span class="bg-amber-100 text-amber-700 px-4 py-1 rounded-full text-sm font-semibold">Teacher</span>
          </div>

          <p class="text-gray-600 text-lg mb-8">Dedicated educator helping students build strong artistic and academic foundations.</p>

          {/* Info Cards */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Subject</p>
              <p class="font-bold text-lg text-gray-900">{teacher.subject}</p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Experience</p>
              <p class="font-bold text-xl text-gray-900">{teacher.experience} Years</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Role</p>
              <p class="font-bold text-gray-900">Faculty Member</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Achievements</p>
              <p class="font-bold text-md text-gray-900">{teacher.achievements.split(',')[0]}</p>
            </div>

          </div>

          {/* Additional Details */}
          {
            teacher.subject && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">Subject:</span>
                <span class="ml-2 text-gray-700">{teacher.subject}</span>
              </div>
            )
          }

          {
            teacher.experience && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">Experience:</span>
                <span class="ml-2 text-gray-700">{teacher.experience} Years</span>
              </div>
            )
          }

          {
            teacher.about && (
              <div class="mt-8 border-t pt-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3">About Teacher</h3>
                <p class="text-gray-600 leading-relaxed">{teacher.about}</p>
              </div>
            )
          }

        </div>

      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Achievements Section -->
      <section class="bg-white rounded-2xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Achievements</h2>
        <ul class="space-y-3">
          {teacher.achievements.split(',').map((achievement: string) => (
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">{achievement}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Classes Section -->
      <section class="bg-white rounded-2xl shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Classes Taught</h2>
        <ul class="space-y-3">
          {teacher.classes_taught.split(',').map((classItem: string) => (
            <li class="flex items-start">
              <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
              </svg>
              <span class="text-gray-600">{classItem}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
