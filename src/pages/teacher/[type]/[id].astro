---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const teacherResponse = await fetch('https://client-directus.siliconpin.in/items/teacher?filter[status][_eq]=published');
  const teacherData = await teacherResponse.json();
  const teachers = teacherData.data || [];
  // console.log(teachers)
  return teachers.map((teacher: any) => {
    const type = teacher.teacher_type ? teacher.teacher_type.replace('_teacher', '') : 'school';
    return {
      params: {
        type,
        id: teacher.id.toString()
      },
      props: { teacher },
    };
  });
}

const { teacher } = Astro.props;
const { type, id } = Astro.params;

if (!teacher || !id) {
  return Astro.redirect('/404');
}

const galleryResponse = await fetch(`https://client-directus.siliconpin.in/items/teacher_gallery?filter[status][_eq]=published&filter[art_work_by][_eq]=${teacher.id}`);
const galleryData = await galleryResponse.json();
const paintings = galleryData.data || [];

const achievements = teacher.achievements ? teacher.achievements.split(',').map((s: string) => s.trim()).filter(Boolean) : [];
const classesTaught = teacher.classes_taught ? teacher.classes_taught.split(',').map((s: string) => s.trim()).filter(Boolean) : [];
const primaryAchievement = achievements[0] || "Faculty Member";

const isSchool = type === 'school';
const displayType = isSchool ? 'School' : 'Community';

const title = `${teacher.name} - ${displayType} Teacher Profile - Rong Pencil Art Academy`;
const description = isSchool
  ? `Meet school teacher and educator ${teacher.name} at Rong Pencil Art Academy. Subject: ${teacher.subject}. Experience: ${teacher.experience} years. Discover classes taught and achievements.`
  : `Profile of community teacher and artisan ${teacher.name} at Rong Pencil Art Academy. Subject: ${teacher.subject}. Experience: ${teacher.experience} years. Learn about their teachings.`;

const keywords = isSchool
  ? `${teacher.name}, school teacher profile, drawing faculty, academic art instructor, ${teacher.subject || ''}`
  : `${teacher.name}, community teacher, artisan mentor, folk art instructor, ${teacher.subject || ''}`;

const siteUrl = Astro.site ? Astro.site.href : (import.meta.env.PUBLIC_SITE_URL || 'https://rongpencilartacademy.in');

const teacherSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": teacher.name,
  "jobTitle": `${displayType} Teacher - ${teacher.subject || 'Fine Arts'}`,
  "image": teacher.img ? `https://client-directus.siliconpin.in/assets/${teacher.img}` : undefined,
  "worksFor": {
    "@type": "EducationalOrganization",
    "name": "Rong Pencil Art Academy",
    "url": siteUrl
  }
};
---

<Layout 
  title={title}
  description={description}
  keywords={keywords}
  ogImage={`https://client-directus.siliconpin.in/assets/${teacher.img}`}
  schema={teacherSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back Button -->
    <a href={`/teacher/${type}`} class="inline-flex items-center text-amber-600 hover:text-amber-700 mb-8 font-semibold">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to {displayType} Teachers
    </a>

    <!-- Teacher Profile Header -->
    <div class="bg-gradient-to-r from-amber-50 via-white to-orange-50 rounded-3xl shadow-xl overflow-hidden mb-12 border border-amber-100">
      <div class="md:flex">

        {/* Teacher Image */}
        <div class="md:w-1/3 p-6">
          <div class="overflow-hidden rounded-2xl shadow-lg h-[450px]">
            {teacher.img ? (
              <img
                src={`https://client-directus.siliconpin.in/assets/${teacher.img}`}
                alt={teacher.name}
                class="w-full h-full object-cover hover:scale-105 transition duration-500"
              />
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 bg-gray-50 border border-gray-100">
                <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span class="text-sm font-medium text-gray-500">Image not available</span>
              </div>
            )}
          </div>
        </div>

        {/* Teacher Details */}
        <div class="md:w-2/3 p-8 lg:p-12">

          <div class="flex flex-wrap items-center gap-3 mb-2">
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">{teacher.name}</h1>
            <span class="bg-amber-100 text-amber-700 px-4 py-1 rounded-full text-sm font-semibold">Teacher</span>
          </div>

          {!isSchool && teacher.school_name && (
            <div class="mb-5">
              <span class="inline-flex items-center px-4 py-2 bg-amber-50 text-amber-800 rounded-lg shadow-sm border border-amber-200/50">
                <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <span class="font-bold mr-1">School:</span> {teacher.school_name}
              </span>
            </div>
          )}

          <p class="text-gray-600 text-lg mb-8">Dedicated educator helping students build strong artistic and academic foundations.</p>

          {/* Info Cards */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Subject</p>
              <p class="font-bold text-lg text-gray-900">{teacher.subject}</p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Experience</p>
              <p class="font-bold text-xl text-gray-900">{teacher.experience} Years</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Role</p>
              <p class="font-bold text-gray-900">Faculty Member</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Achievements</p>
              <p class="font-bold text-md text-gray-900">{primaryAchievement}</p>
            </div>
          </div>

          {
            teacher.experience && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">Experience:</span>
                <span class="ml-2 text-gray-700">{teacher.experience} Years</span>
              </div>
            )
          }

          {
            teacher.qualification && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">Qualification:</span>
                <ul class="list-disc list-outside ml-6 mt-1 text-xs text-gray-700 space-y-1">
                  {
                    typeof teacher.qualification === 'string' 
                      ? teacher.qualification.split('|').map((q: string) => (
                          <li>{q.trim()}</li>
                        ))
                      : Array.isArray(teacher.qualification)
                        ? teacher.qualification.map((q: any) => <li>{String(q).trim()}</li>)
                        : <li>{String(teacher.qualification)}</li>
                  }
                </ul>
              </div>
            )
          }



          {
            teacher.about && (
              <div class="mt-8 border-t pt-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3">About Teacher</h3>
                <p class="text-gray-600 leading-relaxed">{teacher.about}</p>
              </div>
            )
          }

        </div>

      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Achievements Section -->
      {achievements.length > 0 && (
        <section class="bg-white rounded-2xl shadow-lg p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Achievements</h2>
          <ul class="space-y-3">
            {achievements.map((achievement: string) => (
              <li class="flex items-start">
                <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-600">{achievement}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Classes Section -->
      {classesTaught.length > 0 && (
        <section class="bg-white rounded-2xl shadow-lg p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Classes Taught</h2>
          <ul class="space-y-3">
            {classesTaught.map((classItem: string) => (
              <li class="flex items-start">
                <svg class="w-6 h-6 text-amber-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
                </svg>
                <span class="text-gray-600">{classItem}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <!-- Gallery Section -->
    <div class="mt-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-900">
          Artwork Gallery
        </h2>
        <span class="bg-amber-100 text-amber-700 px-4 py-2 rounded-full text-sm font-semibold">
          {paintings.length} Artwork
        </span>
      </div>

      {
        paintings.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {paintings.map((painting: any, index: any) => (
              <div class="painting-card group bg-white rounded-3xl shadow-md hover:shadow-2xl overflow-hidden transition duration-300 border border-gray-100 cursor-pointer"
                   data-index={index}
                   onclick={`openLightbox(${index})`}>
                <div class="overflow-hidden relative">
                  <img src={`https://client-directus.siliconpin.in/assets/${painting.img}`} alt={painting.title} class="w-full h-72 object-cover group-hover:scale-110 transition duration-500" />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="p-6">
                  {/* <h3 class="text-xl font-bold text-gray-900 mb-3">{painting.title}</h3> */}
                  <div class="space-y-2 text-sm">
                    {
                      painting.title && (
                        <div class="flex justify-between">
                          <span class="text-gray-500">Title</span>
                          <span class="font-medium text-gray-800">{painting.title || "N/A"}</span>
                        </div>
                      )
                    }
                    {
                      painting.medium && (
                        <div class="flex justify-between">
                          <span class="text-gray-500">Medium</span>
                          <span class="font-medium text-gray-800">{painting.medium || "N/A"}</span>
                        </div>
                      )
                    }

                    {
                      painting.year && (
                        <div class="flex justify-between">
                          <span class="text-gray-500">Year</span>
                          <span class="font-medium text-gray-800">{painting.year || "N/A"}</span>
                        </div>
                      )
                    }

                    {
                      painting.size && (
                        <div class="flex justify-between">
                          <span class="text-gray-500">Size</span>
                          <span class="font-medium text-gray-800">{painting.size || "N/A"}</span>
                        </div>
                      )
                    }
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-3xl p-16 text-center border border-amber-100">
            <div class="text-6xl mb-4">🎨</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">No Artwork Available</h3>
            <p class="text-gray-600">This teacher has not uploaded any artwork yet.</p>
          </div>
        )
      }
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
      <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <button onclick="navigateImage(-1)" class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button onclick="navigateImage(1)" class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
        <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
        <div class="mt-4 text-center text-white">
          <h3 id="lightbox-title" class="text-2xl font-bold mb-1"></h3>
          <p id="lightbox-artist" class="text-gray-300"></p>
          <p id="lightbox-medium" class="text-amber-400 font-semibold mt-1"></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ paintings, teacher }}>
  let currentIndex = 0;
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxArtist = document.getElementById('lightbox-artist');
  const lightboxMedium = document.getElementById('lightbox-medium');

  window.openLightbox = function(index) {
    currentIndex = index;
    updateLightboxContent();
    if(lightbox) {
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeLightbox = function() {
    if(lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = 'auto';
    }
  };

  window.navigateImage = function(direction) {
    currentIndex += direction;
    if (currentIndex < 0) {
      currentIndex = paintings.length - 1;
    } else if (currentIndex >= paintings.length) {
      currentIndex = 0;
    }
    updateLightboxContent();
  };

  function updateLightboxContent() {
    const painting = paintings[currentIndex];
    if(painting && lightboxImage) {
      lightboxImage.src = `https://client-directus.siliconpin.in/assets/${painting.img}`;
      lightboxImage.alt = painting.title;
      if(lightboxTitle) lightboxTitle.textContent = painting.title;
      if(lightboxArtist) lightboxArtist.textContent = `by ${teacher.name}`;
      if(lightboxMedium) lightboxMedium.textContent = `${painting.medium || 'N/A'} • ${painting.size || 'N/A'}`;
    }
  }

  if(typeof document !== 'undefined') {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') navigateImage(-1);
      else if (e.key === 'ArrowRight') navigateImage(1);
    });

    if(lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }
  }
</script>