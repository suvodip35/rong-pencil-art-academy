---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { type: 'school' } },
    { params: { type: 'community' } },
  ];
}

const { type } = Astro.params;

const response = await fetch(`https://client-directus.siliconpin.in/items/teacher?filter[status][_eq]=published&filter[teacher_type][_eq]=${type}_teacher`);
const teachersData = await response.json();
const teachers = teachersData.data || [];

const displayTitles: Record<string, string> = {
  school: "School Teachers",
  community: "Community Teachers",
};

const displayDescriptions: Record<string, string> = {
  school: "Our dedicated full-time teachers at the academy",
  community: "Local artisans and experts who share their knowledge with our students",
};

const seoDescriptions: Record<string, string> = {
  school: "Meet the core faculty and academic drawing/painting teachers guiding students through structured curricula at Rong Pencil Art Academy.",
  community: "Learn about our community teachers and local expert artisans sharing traditional and contemporary art styles with students at Rong Pencil Art Academy.",
};

const seoKeywords: Record<string, string> = {
  school: "school teachers, art academy faculty, drawing instructors, art staff, painting educators",
  community: "community teachers, local artisans, craft experts, folk art instructors, Rong Pencil teaching staff",
};
---

<Layout 
  title={`${displayTitles[type]} - Rong Pencil Art Academy`}
  description={seoDescriptions[type]}
  keywords={seoKeywords[type]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{displayTitles[type]}</h1>
      <p class="text-xl text-gray-600">{displayDescriptions[type]}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {teachers.map((teacher: any) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="relative">
            <img 
              src={`https://client-directus.siliconpin.in/assets/${teacher.img}`} 
              alt={teacher.name}
              class="w-full h-64 object-cover"
            />
            <div class="absolute top-4 right-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
              {teacher.experience} Years
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{teacher.name}</h3>
            <div class="space-y-2 text-gray-600 mb-4">
              <p><span class="font-semibold text-amber-700">Subject:</span> {teacher.subject}</p>
              <p><span class="font-semibold text-amber-700">Experience:</span> {teacher.experience} Years</p>
            </div>
            <a href={`/teacher/${type}/${teacher.id}`} class="inline-block bg-amber-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-amber-600 transition-colors">
              View Profile
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
