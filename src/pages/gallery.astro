---
import Layout from '../layouts/Layout.astro';
const BASE_URL = 'https://client-directus.siliconpin.in';
const paintingsResponse = await fetch(`${BASE_URL}/items/gallery?filter[status][_eq]=published`);
const paintingsData = await paintingsResponse.json();
const paintings = paintingsData.data || [];

// Sort paintings by year descending (newest first)
paintings.sort((a: any, b: any) => {
  const yearA = parseInt(a.year) || 0;
  const yearB = parseInt(b.year) || 0;
  return yearB - yearA;
});
// Group paintings by program for sequential sections
const programs = [...new Set(paintings.map((p: any) => p.program).filter(Boolean))];

let sortedPaintings: any[] = [];
const groupedPaintings = programs.map(program => {
  const artworks = paintings.filter((p: any) => p.program === program);
  sortedPaintings = [...sortedPaintings, ...artworks];
  return { title: program, artworks };
});

const otherArtworks = paintings.filter((p: any) => !p.program);
if (otherArtworks.length > 0) {
  sortedPaintings = [...sortedPaintings, ...otherArtworks];
  groupedPaintings.push({ title: 'Other Artworks', artworks: otherArtworks });
}

const gallerySchema = paintings.map((artwork: any) => ({
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": artwork.title || "Artwork",
  "artform": artwork.type || "Painting",
  "artMedium": artwork.program || "Fine Art",
  "image": artwork.image ? `${BASE_URL}/assets/${artwork.image}` : undefined,
  "creator": {
    "@type": "EducationalOrganization",
    "name": "Rong Pencil Art Academy"
  }
}));
---

<Layout 
  title="Art Gallery - Rong Pencil Art Academy"
  description="Browse through the complete gallery of creative artworks, drawings, oil paintings, and watercolor designs by the students and faculty of Rong Pencil Art Academy."
  keywords="art gallery Kolsur, student painting gallery, sketching display, oil paintings portfolio, creative craft gallery"
  schema={gallerySchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Art Gallery</h1>
      <p class="text-xl text-gray-600">Explore beautiful artworks created by our talented artists</p>
    </div>

    {groupedPaintings.map((group) => (
      <div class="mb-16">
        <div class="flex items-center mb-8">
          <h2 class="text-3xl font-bold text-gray-900">{group.title}</h2>
          <div class="ml-4 flex-grow h-px bg-amber-500/30"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {group.artworks.map((artwork: any) => (
            <div class="artwork-card bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 group cursor-pointer"
                 data-id={artwork.id}>
              <div class="relative overflow-hidden">
                <img
                  src={`${BASE_URL}/assets/${artwork.image}`}
                  alt={artwork.title}
                  class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
                /> 
                <div class="absolute top-4 left-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                  {artwork.type}
                </div>
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                  </svg>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold text-gray-900 mb-2">{artwork.title}</h3>
                {artwork.location && <p class="text-gray-600">{`at ${artwork.location}`}</p>}
                {artwork.year && <p class="text-sm text-gray-500 mt-1">{artwork.year}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
    <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button onclick="navigateImage(-1)" class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button onclick="navigateImage(1)" class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
      <div class="mt-4 text-center text-white">
        <h3 id="lightbox-title" class="text-2xl font-bold mb-1"></h3>
        <p id="lightbox-artist" class="text-gray-300"></p>
        <p id="lightbox-category" class="text-amber-400 font-semibold mt-1"></p>
        <p id="lightbox-type" class="text-sm text-gray-400 mt-1"></p>
      </div>
    </div>
  </div>

  <script define:vars={{ sortedPaintings, BASE_URL }}>
    let currentIndex = 0;
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxArtist = document.getElementById('lightbox-artist');
    const lightboxCategory = document.getElementById('lightbox-category');
    const lightboxType = document.getElementById('lightbox-type');

    // Make functions globally accessible
    window.openLightbox = function(id) {
      currentIndex = sortedPaintings.findIndex(p => p.id === id);
      if (currentIndex === -1) return;
      updateLightboxContent();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = 'auto';
    };

    window.navigateImage = function(direction) {
      currentIndex += direction;
      if (currentIndex < 0) {
        currentIndex = sortedPaintings.length - 1;
      } else if (currentIndex >= sortedPaintings.length) {
        currentIndex = 0;
      }
      updateLightboxContent();
    };

    function updateLightboxContent() {
      const artwork = sortedPaintings[currentIndex];
      if (!artwork) return;
      lightboxImage.src = `${BASE_URL}/assets/${artwork.image}`;
      lightboxImage.alt = artwork.title;
      lightboxTitle.textContent = artwork.title;
      lightboxArtist.textContent = artwork.location ? `at ${artwork.location}` : '';
      lightboxCategory.textContent = artwork.program || '';
      lightboxType.textContent = artwork.type ? `🎨 ${artwork.type}` : '';
    }

    // Add event listeners to artwork cards
    document.querySelectorAll('.artwork-card').forEach(card => {
      card.addEventListener('click', function() {
        const id = parseInt(this.getAttribute('data-id'));
        window.openLightbox(id);
      });
    });

    // Close lightbox on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        window.navigateImage(-1);
      } else if (e.key === 'ArrowRight') {
        window.navigateImage(1);
      }
    });

    // Close lightbox when clicking outside the image
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        window.closeLightbox();
      }
    });
  </script>
</Layout>
