---
import Layout from '../layouts/Layout.astro';
const response = await fetch('https://client-directus.siliconpin.in/items/painting?fields=*,painted_by.name&filter[status][_eq]=published')
const paintingsData = await response.json()
const paintings = paintingsData.data
// console.log(paintings)
---

<Layout 
  title="Paintings Portfolio - Rong Pencil Art Academy"
  description="View fine art paintings in acrylic, watercolor, and oil medium created by our academy artists and students. See their creative details and sizes."
  keywords="watercolor paintings, oil canvas art, student paintings Kolsur, acrylic paintings portfolio"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-amber-50/50 to-transparent border border-amber-100 mb-16">
      <!-- Subtle background decorations -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-amber-200/30 rounded-full mix-blend-multiply filter blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-[24rem] h-[24rem] bg-orange-200/20 rounded-full mix-blend-multiply filter blur-3xl"></div>
      </div>
      
      <div class="relative z-10 px-6 py-16 sm:px-12 sm:py-20 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center justify-center space-x-3 mb-6">
          <span class="h-px w-8 bg-amber-300"></span>
          <span class="text-amber-700 text-sm font-semibold tracking-widest uppercase">Our Collection</span>
          <span class="h-px w-8 bg-amber-300"></span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-900 mb-6 tracking-tight">
          Explore the <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 to-orange-500">Paintings</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed font-light">
          Discover a beautiful collection of fine art created by our talented artists and students. From delicate watercolors to rich oil canvases, immerse yourself in our creative expressions.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {paintings.map((painting : any, index: any) => (
        <div class="painting-card bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 group cursor-pointer"
             data-index={index}>
          <div class="relative overflow-hidden">
            <img
              src={`https://client-directus.siliconpin.in/assets/${painting.img}`}
              alt={painting.paint_name}
              loading="lazy"
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            />
            {painting.medium && <div class="absolute top-4 left-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">{painting.medium}</div>}
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
              </svg>
            </div>
          </div>
          <div class="p-6">
            { painting.paint_name && <h3 class="text-xl font-bold text-gray-900 mb-2">{painting.paint_name}</h3>}
            <div class="space-y-1 text-gray-600">
              { painting.size && <p><span class="font-semibold text-amber-700">Size:</span> {painting.size}</p>}
              { painting.painted_by.name && <p><span class="font-semibold text-amber-700">Artist:</span> {painting.painted_by.name}</p>}
              { painting.medium && <p><span class="font-semibold text-amber-700">Medium:</span> {painting.medium}</p>}
              { painting.year && <p><span class="font-semibold text-amber-700">Year:</span> {painting.year}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
    <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button onclick="navigateImage(-1)" class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button onclick="navigateImage(1)" class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-2xl" />
      <div class="mt-6 text-center text-white bg-black/50 px-8 py-4 rounded-xl backdrop-blur-sm">
        <h3 id="lightbox-title" class="text-2xl font-bold mb-2"></h3>
        <p id="lightbox-artist" class="text-gray-300 text-lg"></p>
        <div class="flex items-center justify-center gap-4 mt-3">
          <p id="lightbox-medium" class="text-amber-400 font-semibold"></p>
          <span id="lightbox-dot" class="text-gray-500 hidden">•</span>
          <p id="lightbox-size" class="text-amber-400 font-semibold"></p>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ paintings }}>
    let currentIndex = 0;
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxArtist = document.getElementById('lightbox-artist');
    const lightboxMedium = document.getElementById('lightbox-medium');
    const lightboxSize = document.getElementById('lightbox-size');
    const lightboxDot = document.getElementById('lightbox-dot');

    // Make functions globally accessible
    window.openLightbox = function(index) {
      currentIndex = index;
      updateLightboxContent();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = 'auto';
    };

    window.navigateImage = function(direction) {
      currentIndex += direction;
      if (currentIndex < 0) {
        currentIndex = paintings.length - 1;
      } else if (currentIndex >= paintings.length) {
        currentIndex = 0;
      }
      updateLightboxContent();
    };

    function updateLightboxContent() {
      const painting = paintings[currentIndex];
      lightboxImage.src = `https://client-directus.siliconpin.in/assets/${painting.img}`;
      lightboxImage.alt = painting.paint_name;
      lightboxTitle.textContent = painting.paint_name;
      
      // Safely handle missing artist data
      if (painting.painted_by && painting.painted_by.name) {
        lightboxArtist.textContent = `Artist: ${painting.painted_by.name}`;
      } else {
        lightboxArtist.textContent = '';
      }

      lightboxMedium.textContent = painting.medium || '';
      lightboxSize.textContent = painting.size || '';

      if (painting.medium && painting.size) {
        lightboxDot.classList.remove('hidden');
      } else {
        lightboxDot.classList.add('hidden');
      }
    }

    // Add event listeners to painting cards
    document.querySelectorAll('.painting-card').forEach(card => {
      card.addEventListener('click', function() {
        const index = parseInt(this.getAttribute('data-index'));
        window.openLightbox(index);
      });
    });

    // Close lightbox on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        window.navigateImage(-1);
      } else if (e.key === 'ArrowRight') {
        window.navigateImage(1);
      }
    });

    // Close lightbox when clicking outside the image
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        window.closeLightbox();
      }
    });
  </script>
</Layout>
