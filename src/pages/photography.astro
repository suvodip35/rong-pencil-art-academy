---
import Layout from '../layouts/Layout.astro';

const photos = [
  {
    id: 1,
    title: "Golden Hour Portrait",
    photographer: "Rohan Chakraborty",
    category: "Portrait",
    image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=600&h=400&fit=crop"
  },
  {
    id: 2,
    title: "Nature's Beauty",
    photographer: "Priya Sharma",
    category: "Nature",
    image: "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&h=400&fit=crop"
  },
  {
    id: 3,
    title: "Street Life",
    photographer: "Aarav Roy",
    category: "Street",
    image: "https://images.unsplash.com/photo-1449824913929-4a108cc4aa7f?w=600&h=400&fit=crop"
  },
  {
    id: 4,
    title: "Architecture",
    photographer: "Ananya Das",
    category: "Architecture",
    image: "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=600&h=400&fit=crop"
  },
  {
    id: 5,
    title: "Wildlife Capture",
    photographer: "Sneha Mukherjee",
    category: "Wildlife",
    image: "https://images.unsplash.com/photo-1474511320723-9a56873571b7?w=600&h=400&fit=crop"
  },
  {
    id: 6,
    title: "Macro World",
    photographer: "Dev Adhikari",
    category: "Macro",
    image: "https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?w=600&h=400&fit=crop"
  }
];
---

<Layout title="Photography - Rong Pencil Art Academy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Photography</h1>
      <p class="text-xl text-gray-600">Stunning photographs captured by our talented photographers</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {photos.map((photo) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 group">
          <div class="relative overflow-hidden">
            <img 
              src={photo.image} 
              alt={photo.title}
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            />
            <div class="absolute top-4 left-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
              {photo.category}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{photo.title}</h3>
            <p class="text-gray-600">by {photo.photographer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
