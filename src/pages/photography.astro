---
import Layout from '../layouts/Layout.astro';

const photos = [
  {
    id: 1,
    title: "Golden Hour Portrait",
    photographer: "Rohan Chakraborty",
    category: "Portrait",
    image: "/assets/photography_portrait.jpg"
  },
  {
    id: 2,
    title: "Nature's Beauty",
    photographer: "Priya Sharma",
    category: "Nature",
    image: "/assets/photography_nature.jpg"
  },
  {
    id: 3,
    title: "Street Life",
    photographer: "Aarav Roy",
    category: "Street",
    image: "/assets/photography_street.jpg"
  },
  {
    id: 4,
    title: "Architecture",
    photographer: "Ananya Das",
    category: "Architecture",
    image: "/assets/photography_architecture.jpg"
  },
  {
    id: 5,
    title: "Wildlife Capture",
    photographer: "Sneha Mukherjee",
    category: "Wildlife",
    image: "/assets/photography_wildlife.jpg"
  },
  {
    id: 6,
    title: "Macro World",
    photographer: "Dev Adhikari",
    category: "Macro",
    image: "/assets/photography_macro.jpg"
  }
];
---

<Layout 
  title="Photography Portfolio - Rong Pencil Art Academy"
  description="View stunning photographs across portrait, nature, street, macro, and wildlife categories captured by the creative photographers of our academy."
  keywords="nature photography, portrait captures, street photography, macro world, wildlife capture, photography students"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Photography</h1>
      <p class="text-xl text-gray-600">Stunning photographs captured by our talented photographers</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {photos.map((photo) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 group">
          <div class="relative overflow-hidden">
            <img 
              src={photo.image} 
              alt={photo.title}
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300"
            />
            <div class="absolute top-4 left-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
              {photo.category}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{photo.title}</h3>
            <p class="text-gray-600">by {photo.photographer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
