---
import Layout from '../../layouts/Layout.astro';
import NoticeList from '../../components/NoticeList.vue';
---

<Layout 
  title="Notice Board - Rong Pencil Art Academy"
  description="Stay updated with the latest announcements, notices, and updates from Rong Pencil Art Academy."
>
  <main class="min-h-screen bg-gray-50 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Notice Board</h1>
        <p class="text-xl text-gray-600">Latest announcements and updates</p>
      </div>

      <NoticeList client:load />
      
    </div>
  </main>
</Layout>
