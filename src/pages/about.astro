---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Rong Pencil Art Academy">
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-gray-50 to-amber-50 py-20 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-5xl font-bold text-gray-900 mb-6">About Rong Pencil Art Academy</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Discover our journey, mission, and commitment to nurturing artistic excellence in Kolsur, North 24 Pargana
        </p>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">Our Story</h2>
            <p class="text-lg text-gray-600 mb-4 leading-relaxed">
              Rong Pencil Art Academy was founded with a vision to provide quality art education to students of all ages in Kolsur, North 24 Pargana. What started as a small art class has grown into a comprehensive art academy serving over 500 students.
            </p>
            <p class="text-lg text-gray-600 mb-4 leading-relaxed">
              Our founder, passionate about art and education, believed that every individual has creative potential waiting to be unlocked. This belief continues to drive our mission today.
            </p>
            <p class="text-lg text-gray-600 leading-relaxed">
              Over the years, we have expanded our curriculum to include various art forms including pencil sketching, watercolor, oil painting, charcoal drawing, and traditional crafts, ensuring our students receive a well-rounded art education.
            </p>
          </div>
          <div>
            <img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600&h=500&fit=crop" alt="Art Class" class="rounded-3xl shadow-2xl" />
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Vision Section -->
    <section class="py-20 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="bg-white p-8 rounded-3xl shadow-lg">
            <div class="text-5xl mb-4">🎯</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Our Mission</h3>
            <p class="text-gray-600 leading-relaxed">
              To provide accessible, high-quality art education that nurtures creativity, builds confidence, and helps students discover their unique artistic voice. We strive to create a supportive environment where every student can thrive and express themselves through art.
            </p>
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-lg">
            <div class="text-5xl mb-4">👁️</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Our Vision</h3>
            <p class="text-gray-600 leading-relaxed">
              To be the leading art academy in North 24 Pargana, recognized for excellence in art education and for producing talented artists who contribute to the cultural landscape. We envision a community where art is valued and accessible to all.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">Our Values</h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">The principles that guide everything we do</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-8">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl">🎨</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Creativity</h3>
            <p class="text-gray-600">We encourage creative expression and innovative thinking in all our students.</p>
          </div>
          <div class="text-center p-8">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl">🤝</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Community</h3>
            <p class="text-gray-600">We foster a supportive community where students learn from and inspire each other.</p>
          </div>
          <div class="text-center p-8">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl">✨</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Excellence</h3>
            <p class="text-gray-600">We strive for excellence in teaching and help students achieve their best.</p>
          </div>
        </div>
      </div>
    </section>

