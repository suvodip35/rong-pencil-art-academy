---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Admissions - Rong Pencil Art Academy"
  description="Enrol at Rong Pencil Art Academy. Fill out our online application form to start your courses in pencil sketching, watercolor, oil painting, and more."
  keywords="art school admission, apply to art academy, pencil sketch course enrollment, Kolsur art classes"
>
  <main id="admissionPageContent">
    <!-- Hero Section -->
    <section class="print:hidden relative min-h-[85vh] flex items-center justify-center bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50 overflow-hidden">
      <!-- Subtle Background Pattern -->
      <div class="absolute inset-0 opacity-30">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(251, 191, 36, 0.15) 1px, transparent 0); background-size: 40px 40px;"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-4 py-20 text-center">
        <div class="inline-flex items-center gap-2 mb-8 px-5 py-2.5 bg-white rounded-full border-2 border-amber-200 shadow-sm">
          <span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
          <span class="text-amber-700 font-semibold text-sm">Admissions Open for {new Date().getFullYear()}-{new Date().getFullYear() + 1}</span>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight">
          Begin Your
          <span class="text-amber-600"> Artistic</span>
          <br />
          Journey Today
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto mb-12 leading-relaxed">
          Join Rong Pencil Art Academy and transform your passion into masterpieces. 
          Where creativity meets excellence.
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
          <a href="#application-form" class="inline-flex items-center justify-center px-8 py-4 bg-amber-600 text-white font-semibold rounded-xl hover:bg-amber-700 transition-all shadow-lg hover:shadow-xl">
            Start Application
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          
          <a href="#process" class="inline-flex items-center justify-center px-8 py-4 bg-white text-amber-700 font-semibold rounded-xl border-2 border-amber-200 hover:bg-amber-50 transition-all">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            How It Works
          </a>
        </div>
        
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
            <div class="text-md font-bold text-amber-600 mb-1">Expert Faculty</div>
            <div class="text-gray-600 text-xs font-medium">Guidance from experienced instructors</div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
            <div class="text-md font-bold text-amber-600 mb-1">Practical Learning</div>
            <div class="text-gray-600 text-xs font-medium">Hands-on training and projects</div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
            <div class="text-md font-bold text-amber-600 mb-1">Creative Courses</div>
            <div class="text-gray-600 text-xs font-medium">Programs for all skill levels</div>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
            <div class="text-md font-bold text-amber-600 mb-1">Student Focused</div>
            <div class="text-gray-600 text-xs font-medium">Personalized attention and support</div>
          </div>
        </div>
      </div>
      
      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>

    <!-- Admission Form Section -->
    <section id="application-form" class="py-24 px-4 bg-white">
      <div class="relative max-w-5xl mx-auto">
        <!-- Form Header -->
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-2 bg-amber-100 text-amber-700 rounded-full text-sm font-semibold mb-4">
            📝 Application Form
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            Begin Your
            <span class="text-amber-600"> Journey</span>
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto text-lg">
            Fill in the details below to start your artistic adventure with Rong Pencil Art Academy
          </p>
        </div>

        <!-- Reprint Section -->
        <div class="print:hidden mb-16 max-w-2xl mx-auto bg-amber-50 rounded-2xl p-6 border border-amber-200">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Already Applied?</h3>
          <p class="text-gray-600 text-sm mb-4">Enter your Application ID to reprint or download your application PDF.</p>
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <div class="flex items-stretch border border-gray-300 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-amber-500 focus-within:border-amber-500 flex-grow bg-white w-full">
              <span class="flex items-center px-4 bg-gray-50 border-r border-gray-300 text-gray-600 font-mono font-bold whitespace-nowrap">
                RPAA/{new Date().getFullYear()}/
              </span>
              <input type="number" id="reprintId" class="w-full px-4 py-3 border-none focus:ring-0 outline-none font-mono" placeholder="ID (e.g. 1)" />
            </div>
            <button type="button" id="reprintBtn" class="w-full sm:w-auto px-6 py-3 bg-amber-600 text-white font-semibold rounded-xl hover:bg-amber-700 transition-colors shadow-sm flex items-center justify-center whitespace-nowrap">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
              </svg>
              Reprint
            </button>
          </div>
          <p id="reprintError" class="text-red-500 text-sm mt-3 hidden">Application not found. Please check the ID and try again.</p>
        </div>

        <!-- Progress Steps -->
        <div class="print:hidden flex justify-center mb-16">
          <div class="flex items-center space-x-2 md:space-x-4">
            <div class="flex items-center">
              <div class="w-12 h-12 bg-amber-500 text-white rounded-xl flex items-center justify-center font-bold shadow-md">1</div>
              <span class="ml-2 text-sm font-semibold text-gray-700 hidden md:block">Student</span>
            </div>
            <div class="w-8 md:w-12 h-0.5 bg-amber-300"></div>
            <div class="flex items-center">
              <div class="w-12 h-12 bg-amber-500 text-white rounded-xl flex items-center justify-center font-bold shadow-md">2</div>
              <span class="ml-2 text-sm font-semibold text-gray-700 hidden md:block">Parent</span>
            </div>
            <div class="w-8 md:w-12 h-0.5 bg-amber-300"></div>
            <div class="flex items-center">
              <div class="w-12 h-12 bg-amber-500 text-white rounded-xl flex items-center justify-center font-bold shadow-md">3</div>
              <span class="ml-2 text-sm font-semibold text-gray-700 hidden md:block">Education</span>
            </div>
            <div class="w-8 md:w-12 h-0.5 bg-amber-300"></div>
            <div class="flex items-center">
              <div class="w-12 h-12 bg-amber-500 text-white rounded-xl flex items-center justify-center font-bold shadow-md">4</div>
              <span class="ml-2 text-sm font-semibold text-gray-700 hidden md:block">Course</span>
            </div>
            <div class="w-8 md:w-12 h-0.5 bg-amber-300"></div>
            <div class="flex items-center">
              <div class="w-12 h-12 bg-amber-600 text-white rounded-xl flex items-center justify-center font-bold shadow-md">5</div>
              <span class="ml-2 text-sm font-semibold text-gray-700 hidden md:block">Complete</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-3xl shadow-xl p-8 lg:p-12 border border-gray-200">
          <form id="admissionForm" class="space-y-10">
            <!-- Student Information -->
            <div class="group">
              <div class="flex items-center mb-8">
                <div class="w-14 h-14 bg-amber-500 text-white rounded-2xl flex items-center justify-center mr-4 shadow-md">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">Student Information</h3>
                  <p class="text-gray-500 text-sm">Tell us about the student</p>
                </div>
              </div>
              
              <div class="bg-amber-50 rounded-2xl p-8 border border-amber-100">
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label for="studentName" class="block text-sm font-semibold text-gray-700 mb-3">Full Name *</label>
                    <input type="text" id="studentName" name="studentName" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter student's full name" />
                  </div>
                  
                  <div>
                    <label for="dateOfBirth" class="block text-sm font-semibold text-gray-700 mb-3">Date of Birth *</label>
                    <input type="date" id="dateOfBirth" name="dateOfBirth" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" />
                  </div>
                  
                  <div>
                    <label for="gender" class="block text-sm font-semibold text-gray-700 mb-3">Gender *</label>
                    <select id="gender" name="gender" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm">
                      <option value="">Select gender</option>
                      <option value="male">Male</option>
                      <option value="female">Female</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                  
                  <div>
                    <label for="category" class="block text-sm font-semibold text-gray-700 mb-3">Student Category *</label>
                    <select id="category" name="category" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm">
                      <option value="">Select category</option>
                      <option value="junior">Junior (Age 5-12)</option>
                      <option value="senior">Senior (Age 13-18)</option>
                      <option value="adult">Adult (Age 18+)</option>
                    </select>
                  </div>
                </div>
                
                <div class="mt-6">
                  <label for="address" class="block text-sm font-semibold text-gray-700 mb-3">Address *</label>
                  <textarea id="address" name="address" rows="3" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter complete address"></textarea>
                </div>
              </div>
            </div>

            <!-- Parent/Guardian Information -->
            <div class="group">
              <div class="flex items-center mb-8">
                <div class="w-14 h-14 bg-amber-500 text-white rounded-2xl flex items-center justify-center mr-4 shadow-md">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">Parent/Guardian Information</h3>
                  <p class="text-gray-500 text-sm">Parent or guardian contact details</p>
                </div>
              </div>
              
              <div class="bg-amber-50 rounded-2xl p-8 border border-amber-100">
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label for="parentName" class="block text-sm font-semibold text-gray-700 mb-3">Parent/Guardian Name *</label>
                    <input type="text" id="parentName" name="parentName" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter parent/guardian name" />
                  </div>
                  
                  <div>
                    <label for="relation" class="block text-sm font-semibold text-gray-700 mb-3">Relation *</label>
                    <select id="relation" name="relation" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm">
                      <option value="">Select relation</option>
                      <option value="father">Father</option>
                      <option value="mother">Mother</option>
                      <option value="guardian">Guardian</option>
                    </select>
                  </div>
                  
                  <div>
                    <label for="phone" class="block text-sm font-semibold text-gray-700 mb-3">Phone Number *</label>
                    <input type="tel" id="phone" name="phone" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="+91 XXXXX XXXXX" />
                  </div>
                  
                  <div>
                    <label for="email" class="block text-sm font-semibold text-gray-700 mb-3">Email Address</label>
                    <input type="email" id="email" name="email" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter email address" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Educational Information -->
            <div class="group">
              <div class="flex items-center mb-8">
                <div class="w-14 h-14 bg-amber-500 text-white rounded-2xl flex items-center justify-center mr-4 shadow-md">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">Educational Information</h3>
                  <p class="text-gray-500 text-sm">Current educational background</p>
                </div>
              </div>
              
              <div class="bg-amber-50 rounded-2xl p-8 border border-amber-100">
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label for="school" class="block text-sm font-semibold text-gray-700 mb-3">School/College Name</label>
                    <input type="text" id="school" name="school" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter current school/college" />
                  </div>
                  
                  <div>
                    <label for="classGrade" class="block text-sm font-semibold text-gray-700 mb-3">Class/Grade (Optional)</label>
                    <input type="text" id="classGrade" name="classGrade" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Enter class or grade" />
                  </div>
                </div>
                
                <div class="mt-6">
                  <label for="previousArtExperience" class="block text-sm font-semibold text-gray-700 mb-3">Previous Art Experience (Optional)</label>
                  <textarea id="previousArtExperience" name="previousArtExperience" rows="3" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Describe any previous art training or experience"></textarea>
                </div>
              </div>
            </div>

            <!-- Course Selection -->
            <div class="group">
              <div class="flex items-center mb-8">
                <div class="w-14 h-14 bg-amber-500 text-white rounded-2xl flex items-center justify-center mr-4 shadow-md">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">Course Selection</h3>
                  <p class="text-gray-500 text-sm">Choose your preferred course</p>
                </div>
              </div>
              
              <div class="bg-amber-50 rounded-2xl p-8 border border-amber-100">
                <div>
                  <label for="course" class="block text-sm font-semibold text-gray-700 mb-3">Interested Course *</label>
                  <select id="course" name="course" required class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm">
                    <option value="">Select a course</option>
                    <option value="pencil-sketching">Pencil Sketching</option>
                    <option value="watercolor">Watercolor Painting</option>
                    <option value="oil-painting">Oil Painting</option>
                    <option value="charcoal-drawing">Charcoal Drawing</option>
                    <option value="acrylic">Acrylic Painting</option>
                    <option value="mixed-media">Mixed Media</option>
                    <option value="comprehensive">Comprehensive Art Program</option>
                  </select>
                </div>
                
                <div class="mt-6">
                  <label for="batchPreference" class="block text-sm font-semibold text-gray-700 mb-3">Preferred Batch Timing</label>
                  <select id="batchPreference" name="batchPreference" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm">
                    <option value="">Select preferred timing</option>
                    <option value="morning">Morning (10:00 AM - 12:00 PM)</option>
                    <option value="afternoon">Afternoon (2:00 PM - 4:00 PM)</option>
                    <option value="evening">Evening (4:00 PM - 6:00 PM)</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Additional Information -->
            <div class="group">
              <div class="flex items-center mb-8">
                <div class="w-14 h-14 bg-amber-500 text-white rounded-2xl flex items-center justify-center mr-4 shadow-md">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-gray-900">Additional Information</h3>
                  <p class="text-gray-500 text-sm">Tell us more about yourself</p>
                </div>
              </div>
              
              <div class="bg-amber-50 rounded-2xl p-8 border border-amber-100">
                <div>
                  <label for="reason" class="block text-sm font-semibold text-gray-700 mb-3">Why do you want to join Rong Pencil Art Academy? (Optional)</label>
                  <textarea id="reason" name="reason" rows="4" class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all hover:border-amber-300 shadow-sm" placeholder="Tell us about your motivation to join our academy"></textarea>
                </div>
                
                <div class="mt-6 p-5 bg-white rounded-xl border border-amber-200 shadow-sm">
                  <label class="flex items-start cursor-pointer">
                    <input type="checkbox" name="terms" required class="mt-1 mr-4 w-5 h-5 text-amber-600 border-gray-300 rounded focus:ring-amber-500" />
                    <span class="text-sm text-gray-600">I agree to the terms and conditions and confirm that the information provided is accurate and complete.</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="print:hidden text-center pt-6">
              <button type="submit" id="submitBtn" class="inline-flex items-center justify-center px-12 py-4 bg-amber-600 text-white font-bold text-lg rounded-xl hover:bg-amber-700 transition-all shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed">
                <span class="flex items-center" id="btnText">
                  Submit Application
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </span>
                <svg id="loadingSpinner" class="hidden animate-spin w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
              <p class="mt-4 text-sm text-gray-500">We'll review your application and get back to you within 2-3 business days</p>
              
              <!-- Success/Error Messages -->
              <div id="successMessage" class="hidden mt-6 p-5 bg-green-50 border border-green-200 rounded-2xl">
                <div class="flex flex-col sm:flex-row items-center sm:items-start text-left">
