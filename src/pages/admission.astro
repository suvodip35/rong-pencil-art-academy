  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById("admissionForm");
      const submitBtn = document.getElementById("submitBtn");
      const btnText = document.getElementById("btnText");
      const loadingSpinner = document.getElementById("loadingSpinner");
      const successMessage = document.getElementById("successMessage");
      const errorMessage = document.getElementById("errorMessage");

      // Reprint Logic
      const reprintBtn = document.getElementById("reprintBtn");
      const reprintId = document.getElementById("reprintId");
      const reprintError = document.getElementById("reprintError");

      reprintBtn.addEventListener("click", async () => {
        const id = reprintId.value.trim();
        if (!id) return;
        
        reprintBtn.disabled = true;
        reprintBtn.classList.add("opacity-50");
        reprintBtn.classList.add("cursor-not-allowed");
        reprintError.classList.add("hidden");

        try {
          const response = await fetch(`https://client-directus.siliconpin.in/items/admission/${id}`);
          if (!response.ok) {
            throw new Error('Not found');
          }
          
          const result = await response.json();
          const data = result.data || result;
          
          if (!data || !data.id) {
            throw new Error('Not found');
          }

          // Format ID
          const currentYear = new Date().getFullYear();
          const formattedAppId = `RPAA/${currentYear}/${data.id}`;
          document.getElementById("p_app_id").textContent = formattedAppId;

          // Capitalize helper function
          const capitalize = (s) => {
            if (typeof s !== 'string') return s;
            return s.charAt(0).toUpperCase() + s.slice(1);
          };

          const toLabel = (val) => {
            if (!val) return '';
            // Basic formatting for stored enum values like 'pencil-sketching' -> 'Pencil Sketching'
            return val.split('-').map(word => capitalize(word)).join(' ');
          };

          // Populate Print Area
          document.getElementById("p_name").textContent = data.name || '';
          document.getElementById("p_dob").textContent = data.dob || '';
          document.getElementById("p_gender").textContent = toLabel(data.gender);
          // Special case for category
          let catLabel = toLabel(data.category);
          if (data.category === 'junior') catLabel = 'Junior (Age 5-12)';
          if (data.category === 'senior') catLabel = 'Senior (Age 13-18)';
          if (data.category === 'adult') catLabel = 'Adult (Age 18+)';
          document.getElementById("p_category").textContent = catLabel;
          
          document.getElementById("p_address").textContent = data.address || '';
          document.getElementById("p_parent").textContent = data.parent || '';
          document.getElementById("p_relation").textContent = toLabel(data.relation);
          document.getElementById("p_phone").textContent = data.phone || '';
          document.getElementById("p_email").textContent = data.email || '';
          document.getElementById("p_school").textContent = data.school_name || '';
          document.getElementById("p_class").textContent = data.class || '';
          document.getElementById("p_experience").textContent = data.previous_art_experience || '';
          
          let courseLabel = toLabel(data.interested_course);
          if (data.interested_course === 'comprehensive') courseLabel = 'Comprehensive Art Program';
          document.getElementById("p_course").textContent = courseLabel;
          
          let batchLabel = toLabel(data.batch_timing);
          if (data.batch_timing === 'morning') batchLabel = 'Morning (10:00 AM - 12:00 PM)';
          if (data.batch_timing === 'afternoon') batchLabel = 'Afternoon (2:00 PM - 4:00 PM)';
          if (data.batch_timing === 'evening') batchLabel = 'Evening (4:00 PM - 6:00 PM)';
          document.getElementById("p_batch").textContent = batchLabel;
          
          document.getElementById("p_reason").textContent = data.reason || '';

          // Trigger print
          window.print();
          
        } catch (error) {
          console.error("Reprint error:", error);
          reprintError.classList.remove("hidden");
        } finally {
          reprintBtn.disabled = false;
          reprintBtn.classList.remove("opacity-50");
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Hide any existing messages
        successMessage.classList.add("hidden");
        errorMessage.classList.add("hidden");

        // Disable button and show loading state
        submitBtn.disabled = true;
        btnText.classList.add("hidden");
        loadingSpinner.classList.remove("hidden");

        const formData = {
          name: document.getElementById("studentName").value,
          dob: document.getElementById("dateOfBirth").value,
          gender: document.getElementById("gender").value,
          category: document.getElementById("category").value,
          address: document.getElementById("address").value,

          parent: document.getElementById("parentName").value,
          relation: document.getElementById("relation").value,
          phone: document.getElementById("phone").value,
          email: document.getElementById("email").value,

          school_name: document.getElementById("school").value,
          class: document.getElementById("classGrade").value,
          previous_art_experience: document.getElementById("previousArtExperience").value,

          interested_course: document.getElementById("course").value,
          batch_timing: document.getElementById("batchPreference").value,

          reason: document.getElementById("reason").value
        };

        try {
          // Replace with your actual API endpoint
          const response = await fetch("https://client-directus.siliconpin.in/items/admission", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(formData)
          });

          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }

          const result = await response.json();

          // Generate Application ID
          const apiId = result?.data?.id || result?.id || '';
          const currentYear = new Date().getFullYear();
          const formattedAppId = apiId ? `RPAA/${currentYear}/${apiId}` : '';
          
          document.getElementById("p_app_id").textContent = formattedAppId;
          document.getElementById("success_app_id").textContent = formattedAppId;

          // Populate Print Area
          document.getElementById("p_name").textContent = document.getElementById("studentName").value;
          document.getElementById("p_dob").textContent = document.getElementById("dateOfBirth").value;
          const genderSelect = document.getElementById("gender");
          document.getElementById("p_gender").textContent = genderSelect.options[genderSelect.selectedIndex]?.text || '';
          const categorySelect = document.getElementById("category");
          document.getElementById("p_category").textContent = categorySelect.options[categorySelect.selectedIndex]?.text || '';
          document.getElementById("p_address").textContent = document.getElementById("address").value;

          document.getElementById("p_parent").textContent = document.getElementById("parentName").value;
          const relationSelect = document.getElementById("relation");
          document.getElementById("p_relation").textContent = relationSelect.options[relationSelect.selectedIndex]?.text || '';
          document.getElementById("p_phone").textContent = document.getElementById("phone").value;
          document.getElementById("p_email").textContent = document.getElementById("email").value;

          document.getElementById("p_school").textContent = document.getElementById("school").value;
          document.getElementById("p_class").textContent = document.getElementById("classGrade").value;
          document.getElementById("p_experience").textContent = document.getElementById("previousArtExperience").value;

          const courseSelect = document.getElementById("course");
          document.getElementById("p_course").textContent = courseSelect.options[courseSelect.selectedIndex]?.text || '';
          const batchSelect = document.getElementById("batchPreference");
          document.getElementById("p_batch").textContent = batchSelect.options[batchSelect.selectedIndex]?.text || '';
          document.getElementById("p_reason").textContent = document.getElementById("reason").value;

          // Show success message
          successMessage.classList.remove("hidden");
          
          // Reset form
          form.reset();

          // Scroll to success message
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });

        } catch (error) {
          console.error('Submission error:', error);
          
          // Show error message
          errorMessage.classList.remove("hidden");
          
          // Scroll to error message
          errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } finally {
          // Re-enable button and hide loading state
          submitBtn.disabled = false;
          btnText.classList.remove("hidden");
          loadingSpinner.classList.add("hidden");
        }
      });
    });
  </script>
