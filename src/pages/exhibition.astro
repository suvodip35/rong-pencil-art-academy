---
import Layout from '../layouts/Layout.astro';
const response = await fetch('https://client-directus.siliconpin.in/items/exhibitions');
const data = await response.json();
const exhibitions = data.data;
---

<Layout title="Exhibitions - Rong Pencil Art Academy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Art Exhibitions</h1>
      <p class="text-xl text-gray-600">Discover our past and upcoming art exhibitions</p>
    </div>

    <div class="space-y-8">
      {exhibitions.map((exhibition: any) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="md:flex">
            <div class="md:w-1/3">
              <img 
                src={`https://client-directus.siliconpin.in/assets/${exhibition.img}`} 
                alt={exhibition.title}
                class="w-full h-64 md:h-full object-cover"
              />
            </div>
            <div class="p-6 md:w-2/3">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-bold text-gray-900">{exhibition.title}</h3>
                <span class={`px-4 py-1 rounded-full text-sm font-semibold ${exhibition.exhibition_status === 'Upcoming' ? 'bg-green-100 text-green-800' : exhibition.exhibition_status === 'Cancelled' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800'}`}>{exhibition.exhibition_status}</span>
              </div>
              <div class="space-y-2 text-gray-600 mb-4">
                <p class="flex items-center">
                  <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  {exhibition.date}
                </p>
                <p class="flex items-center">
                  <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  {exhibition.location}
                </p>
              </div>
              <p class="text-gray-700">{exhibition.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
