---
import Layout from '../layouts/Layout.astro';
const response = await fetch('https://client-directus.siliconpin.in/items/exhibitions?filter[status][_eq]=published');
const data = await response.json();
const exhibitions = data.data;
// console.log(exhibitions)
---

<Layout 
  title="Art Exhibitions - Rong Pencil Art Academy"
  description="Explore upcoming and past art exhibitions showcasing the beautiful drawings, paintings, and craft works created by students of Rong Pencil Art Academy."
  keywords="art exhibition Kolsur, student art showcase, painting exhibition, drawing display, art gallery events"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Art Exhibitions</h1>
      <p class="text-xl text-gray-600">Discover our past and upcoming art exhibitions</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {exhibitions.map((exhibition: any) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">
          <div 
            class="relative w-full h-72 bg-gray-100 flex-shrink-0 cursor-pointer group"
            onclick={`window.openLightbox(${exhibition.id})`}
          >
            {exhibition.painting ? (
              <>
                <img 
                  src={`https://client-directus.siliconpin.in/assets/${exhibition.painting}`} 
                  alt={exhibition.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                  </svg>
                </div>
              </>
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 bg-gray-50 border-b border-gray-100">
                <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-sm font-medium">Image coming soon</span>
              </div>
            )}
          </div>
          
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{exhibition.title}</h3>
            
            <div class="space-y-3 mt-auto">
              {exhibition.artist_name && (
                <div class="flex items-start">
                  <span class="text-sm font-bold text-amber-700 w-24 uppercase tracking-wide pt-0.5">Artist</span>
                  <span class="text-gray-800 font-medium flex-1">{exhibition.artist_name}</span>
                </div>
              )}
              {exhibition.painting_title && (
                <div class="flex items-start">
                  <span class="text-sm font-bold text-amber-700 w-24 uppercase tracking-wide pt-0.5">Title</span>
                  <span class="text-gray-800 font-medium flex-1">{exhibition.painting_title}</span>
                </div>
              )}
              {exhibition.medium && (
                <div class="flex items-start">
                  <span class="text-sm font-bold text-amber-700 w-24 uppercase tracking-wide pt-0.5">Medium</span>
                  <span class="text-gray-700 flex-1">{exhibition.medium}</span>
                </div>
              )}
              {exhibition.size && (
                <div class="flex items-start">
                  <span class="text-sm font-bold text-amber-700 w-24 uppercase tracking-wide pt-0.5">Size</span>
                  <span class="text-gray-700 flex-1">{exhibition.size}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
    <button onclick="window.closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button onclick="window.navigateImage(-1)" class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button onclick="window.navigateImage(1)" class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-lg shadow-2xl" />
      <div class="mt-6 text-center text-white bg-black/50 px-8 py-4 rounded-xl backdrop-blur-sm">
        <h3 id="lightbox-title" class="text-2xl font-bold mb-2"></h3>
        <p id="lightbox-artist" class="text-gray-300 text-lg"></p>
        <div class="flex items-center justify-center gap-4 mt-3">
          <p id="lightbox-medium" class="text-amber-400 font-semibold"></p>
          <span id="lightbox-dot" class="text-gray-500 hidden">•</span>
          <p id="lightbox-size" class="text-amber-400 font-semibold"></p>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ exhibitions }}>
    let currentIndex = 0;
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxArtist = document.getElementById('lightbox-artist');
    const lightboxMedium = document.getElementById('lightbox-medium');
    const lightboxSize = document.getElementById('lightbox-size');
    const lightboxDot = document.getElementById('lightbox-dot');
    const BASE_URL = 'https://client-directus.siliconpin.in';

    // Only include exhibitions that have a painting for the lightbox gallery
    const galleryItems = exhibitions.filter(ex => ex.painting);

    window.openLightbox = function(id) {
      currentIndex = galleryItems.findIndex(p => p.id === id);
      if (currentIndex === -1) return;
      updateLightboxContent();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = 'auto';
    };

    window.navigateImage = function(direction) {
      currentIndex += direction;
      if (currentIndex < 0) {
        currentIndex = galleryItems.length - 1;
      } else if (currentIndex >= galleryItems.length) {
        currentIndex = 0;
      }
      updateLightboxContent();
    };

    function updateLightboxContent() {
      const artwork = galleryItems[currentIndex];
      if (!artwork) return;
      
      lightboxImage.src = `${BASE_URL}/assets/${artwork.painting}`;
      lightboxImage.alt = artwork.title;
      lightboxTitle.textContent = artwork.title;
      lightboxArtist.textContent = artwork.artist_name ? `Artist: ${artwork.artist_name}` : '';
      
      lightboxMedium.textContent = artwork.medium || '';
      lightboxSize.textContent = artwork.size || '';
      
      if (artwork.medium && artwork.size) {
        lightboxDot.classList.remove('hidden');
      } else {
        lightboxDot.classList.add('hidden');
      }
    }

    // Close lightbox on escape key
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      
      if (e.key === 'Escape') {
        window.closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        window.navigateImage(-1);
      } else if (e.key === 'ArrowRight') {
        window.navigateImage(1);
      }
    });

    // Close lightbox when clicking outside the image
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        window.closeLightbox();
      }
    });
  </script>
</Layout>
