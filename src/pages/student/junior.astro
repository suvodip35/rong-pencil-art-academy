---
import Layout from '../../layouts/Layout.astro';
const response = await fetch('https://client-directus.siliconpin.in/items/students?filter[status][_eq]=published&filter[type][_eq]=junior') 
const responseData = await response.json()
const students = responseData.data;

---

<Layout 
  title="Junior Students - Rong Pencil Art Academy"
  description="Meet our talented young students developing their sketching and painting skills. View their creative profiles and student details."
  keywords="junior students art, art school students Kolsur, young painters profiles, sketching training"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Junior Students</h1>
      <p class="text-xl text-gray-600">Meet our talented young artists</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {students.map((student: any) => (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
          <div class="relative">
            <img 
              src={`https://client-directus.siliconpin.in/assets/${student.img}`} 
              alt={student.name}
              class="w-full h-64 object-cover"
            />
            <div class="absolute top-4 right-4 bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
              Age: {Math.floor((new Date().getTime() - new Date(student.dob).getTime()) / (1000 * 60 * 60 * 24 * 365))}
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{student.name}</h3>
            <div class="space-y-2 text-gray-600 mb-4">
              <div class="flex items-start">
                <span class="font-semibold text-amber-700 w-32 flex-shrink-0">Date of Birth:</span>
                <span>{new Date(student.dob).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
              </div>
              <div class="flex items-start">
                <span class="font-semibold text-amber-700 w-32 flex-shrink-0">Age:</span>
                <span>{Math.floor((new Date().getTime() - new Date(student.dob).getTime()) / (1000 * 60 * 60 * 24 * 365))} years</span>
              </div>
              <div class="flex items-start">
                <span class="font-semibold text-amber-700 w-32 flex-shrink-0">Address:</span>
                <span class="truncate">{student.address}</span>
              </div>
              {
                student.school && (
                  <div class="flex items-start">
                    <span class="font-semibold text-amber-700 w-32 flex-shrink-0">School:</span>
                    <span class="truncate">{student.school}</span>
                  </div>
                )
              }
              
            </div>
            <a href={`/student/junior/${student.id}`} class="inline-block bg-amber-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-amber-600 transition-colors">
              View Profile
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
