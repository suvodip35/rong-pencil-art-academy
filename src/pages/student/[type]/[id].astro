---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const studentResponse = await fetch('https://client-directus.siliconpin.in/items/students?filter[status][_eq]=published');

  const studentData = await studentResponse.json();
  const students = studentData.data || [];
  return students.map((student : any) => ({
    params: {
      type: student.type || 'junior',
      id: student.id.toString()
    },
    props: { student },
  }));
}

const { student } = Astro.props;
const { type, id } = Astro.params;

if (!student || !id) {
  return Astro.redirect('/404');
}

const paintingResponse = await fetch(`https://client-directus.siliconpin.in/items/painting?filter[status][_eq]=published&filter[painted_by][_eq]=${student.id}`);
const paintingData = await paintingResponse.json();
const paintings = paintingData.data || [];

const displayTitles: Record<string, string> = {
  junior: "Junior Students",
  senior: "Senior Students",
  adult: "Adult Students",
};

const studentTypes: Record<string, string> = {
  junior: "Junior Student",
  senior: "Senior Student",
  adult: "Adult Student",
};
---

<Layout 
  title={`${student.name} - Student Profile - Rong Pencil Art Academy`}
  description={`View the profile, drawing gallery, and paintings of student ${student.name} at Rong Pencil Art Academy. Support our talented young learners.`}
  keywords={`${student.name}, student profile, child artist gallery, student drawings, Rong Pencil Art Academy`}
  ogImage={`https://client-directus.siliconpin.in/assets/${student.img}`}
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back Button -->
    <a href={`/student/${type}`} class="inline-flex items-center text-amber-600 hover:text-amber-700 mb-8 font-semibold">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to {displayTitles[type]}
    </a>

    <!-- Student Profile Header -->
    <div class="bg-gradient-to-r from-amber-50 via-white to-orange-50 rounded-3xl shadow-xl overflow-hidden mb-12 border border-amber-100">
      <div class="md:flex">
        
        <div class="md:w-1/3 p-6">
          <div class="overflow-hidden rounded-2xl shadow-lg">
            <img src={`https://client-directus.siliconpin.in/assets/${student.img}`} alt={student.name} class="w-full h-[450px] object-cover hover:scale-105 transition duration-500" />
          </div>
        </div>

        <div class="md:w-2/3 p-8 lg:p-12">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900">{student.name}</h1>
            <span class="bg-amber-100 text-amber-700 px-4 py-1 rounded-full text-sm font-semibold">{studentTypes[type]}</span>
          </div>

          <p class="text-gray-600 text-lg mb-8">A talented artist from Rong Pencil Art Academy.</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Age</p>
              <p class="font-bold text-xl text-gray-900">{Math.floor((new Date().getTime() - new Date(student.dob).getTime()) / (1000 * 60 * 60 * 24 * 365))} Years</p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Paintings</p>
              <p class="font-bold text-xl text-gray-900">{paintings.length}</p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Date of Birth</p>
              <p class="font-bold text-gray-900">{new Date(student.dob).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric'})}</p>
            </div>

            <div class="bg-white rounded-xl p-4 shadow-sm border">
              <p class="text-sm text-gray-500">Address</p>
              <p class="font-bold text-gray-900">{student.address}</p>
            </div>
          </div>

          {
            student.school && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">School:</span>
                <span class="ml-2 text-gray-700">{student.school}</span>
              </div>
            )
          }
 
          {
            student.drawing_school && (
              <div class="mb-4">
                <span class="font-semibold text-amber-700">Drawing School:</span>
                <span class="ml-2 text-gray-700">{student.drawing_school}</span>
              </div>
            )
          }
          {
            student.about && (
              <div class="mt-8 border-t pt-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3">About Student</h3>
                <p class="text-gray-600 leading-relaxed">{student.about}</p>
              </div>
            )
          }

        </div>

      </div>
    </div>

    <!-- Paintings Section -->
    <div>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-900">
          Artwork Gallery
        </h2>

        <span class="bg-amber-100 text-amber-700 px-4 py-2 rounded-full text-sm font-semibold">
          {paintings.length} Artwork
        </span>
      </div>

      {
        paintings.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            {paintings.map((painting: any, index: any) => (
              <div class="painting-card group bg-white rounded-3xl shadow-md hover:shadow-2xl overflow-hidden transition duration-300 border border-gray-100 cursor-pointer"
                   data-index={index}
                   onclick={`openLightbox(${index})`}>
                <div class="overflow-hidden relative">
                  <img src={`https://client-directus.siliconpin.in/assets/${painting.img}`} alt={painting.title} class="w-full h-72 object-cover group-hover:scale-110 transition duration-500" />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="p-6">
                  <h3 class="text-xl font-bold text-gray-900 mb-3">{painting.title}</h3>
                  <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                      <span class="text-gray-500">Medium</span>
                      <span class="font-medium text-gray-800">{painting.medium || "N/A"}</span>
                    </div>

                    <div class="flex justify-between">
                      <span class="text-gray-500">Year</span>
                      <span class="font-medium text-gray-800">{painting.year || "N/A"}</span>
                    </div>
                  </div>
                </div>
              </div>
            ))}

          </div>
        ) : (
          <div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-3xl p-16 text-center border border-amber-100">
            <div class="text-6xl mb-4">🎨</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">No Artwork Available</h3>
            <p class="text-gray-600">This student has not uploaded any artwork yet.</p>
          </div>
        )
      }
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
      <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <button onclick="navigateImage(-1)" class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button onclick="navigateImage(1)" class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
        <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
        <div class="mt-4 text-center text-white">
          <h3 id="lightbox-title" class="text-2xl font-bold mb-1"></h3>
          <p id="lightbox-artist" class="text-gray-300"></p>
          <p id="lightbox-medium" class="text-amber-400 font-semibold mt-1"></p>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ paintings, student }}>
    let currentIndex = 0;
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxArtist = document.getElementById('lightbox-artist');
    const lightboxMedium = document.getElementById('lightbox-medium');

    // Make functions globally accessible
    window.openLightbox = function(index) {
      currentIndex = index;
      updateLightboxContent();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = 'auto';
    };

    window.navigateImage = function(direction) {
      currentIndex += direction;
      if (currentIndex < 0) {
        currentIndex = paintings.length - 1;
      } else if (currentIndex >= paintings.length) {
        currentIndex = 0;
      }
      updateLightboxContent();
    };

    function updateLightboxContent() {
      const painting = paintings[currentIndex];
      lightboxImage.src = `https://client-directus.siliconpin.in/assets/${painting.img}`;
      lightboxImage.alt = painting.title;
      lightboxTitle.textContent = painting.title;
      lightboxArtist.textContent = `by ${student.name}`;
      lightboxMedium.textContent = `${painting.medium || 'N/A'} • ${painting.year || 'N/A'}`;
    }

    // Close lightbox on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        navigateImage(-1);
      } else if (e.key === 'ArrowRight') {
        navigateImage(1);
      }
    });

    // Close lightbox on background click
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });
  </script>
</Layout>
