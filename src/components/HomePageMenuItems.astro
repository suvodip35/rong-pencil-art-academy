---
const data = [
  {
    title: "Gallery",
    link: "/gallery",
    icon: "🖼️"
  },
  {
    title: "Senior Artist",
    link: "/artist/senior",
    icon: "👨‍🎨"
  },
  {
    title: "Guest Artist",
    link: "/artist/guest",
    icon: "🎭"
  },
  {
    title: "School Teacher",
    link: "/teacher/school",
    icon: "👩‍🏫"
  },
  {
    title: "Community Teacher",
    link: "/teacher/community",
    icon: "🤝"
  },
  {
    title: "Junior Student",
    link: "/student/junior",
    icon: "👦"
  },
  {
    title: "Exhibition",
    link: "/exhibition",
    icon: "🏛️"
  },
  {
    title: "Painting",
    link: "/painting",
    icon: "🎨"
  },
  {
    title: "Photography",
    link: "/photography",
    icon: "📸"
  },
  {
    title: "Art Sale",
    link: "/sale",
    icon: "🛒"
  }
];

const duplicated = [...data, ...data];
---

<section class="py-2 overflow-hidden bg-gradient-to-br from-slate-50 via-white to-amber-50">
  <div class="max-w-7xl mx-auto px-4 mb-12">
    <h2 class="text-4xl font-bold text-center text-slate-900">
      Quick Links
    </h2>

    <p class="text-center text-slate-600 mt-3">
      Explore our academy and discover amazing opportunities
    </p>
  </div>

  <div class="slider-mask">
    <div class="slider-track py-3">
      {
        duplicated.map((item) => (
          <a
            href={item.link}
            class="card group"
          >
            <div class="icon">
              {item.icon}
            </div>

            <h3>{item.title}</h3>

            <span class="explore">
              Explore →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
.slider-mask {
  overflow: hidden;
  position: relative;
  content-visibility: auto;
  contain-intrinsic-size: auto 150px;
}

.slider-mask::before,
.slider-mask::after {
  content: "";
  position: absolute;
  top: 0;
  width: 120px;
  height: 100%;
  z-index: 10;
  pointer-events: none;
}

.slider-mask::before {
  left: 0;
  background: linear-gradient(
    to right,
    white,
    transparent
  );
}

.slider-mask::after {
  right: 0;
  background: linear-gradient(
    to left,
    white,
    transparent
  );
}

.slider-track {
  display: flex;
  gap: 24px;
  width: max-content;
  animation: marquee 35s linear infinite;
}

.slider-track:hover {
  animation-play-state: paused;
}

.card {
  width: 220px;
  flex-shrink: 0;

  background: rgba(255,255,255,.7);
  backdrop-filter: blur(15px);

  border: 1px solid #d97706;

  border-radius: 24px;
  padding: 28px 20px;

  text-align: center;

  transition: all .35s ease;

  box-shadow:
    0 10px 30px rgba(0,0,0,.05);
}

.card:hover {
  transform: translateY(-10px);

  box-shadow:
    0 20px 50px rgba(245,158,11,.25);
}

.icon {
  font-size: 3.5rem;
  margin-bottom: 16px;

  transition: all .4s ease;
}

.card:hover .icon {
  transform: scale(1.2) rotate(8deg);
}

.card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  color: #0f172a;
}

.explore {
  display: inline-block;
  margin-top: 12px;

  color: #f59e0b;
  font-size: .9rem;
  font-weight: 600;

  opacity: 0;
  transform: translateY(10px);

  transition: all .3s ease;
}

.card:hover .explore {
  opacity: 1;
  transform: translateY(0);
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@media (max-width: 768px) {
  .slider-track {
    animation-duration: 22s;
  }

  .card {
    width: 180px;
    padding: 20px;
  }

  .icon {
    font-size: 3rem;
  }
}
</style>