---
import MainHeader from '../components/MainHeader.vue';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
}

const { title, description = "Rong Pencil Art Academy - Nurturing artistic talent and creativity through comprehensive art education in Kolsur, North 24 Pargana.", keywords = "art academy, pencil art, painting, sketching, art education, Kolsur, North 24 Pargana", ogImage } = Astro.props;

// Determine absolute base URL
const siteUrl = Astro.site 
  ? Astro.site.href 
  : (import.meta.env.PUBLIC_SITE_URL || 'https://rongpencilartacademy.in');

// Resolve the canonical URL for the current page
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

const defaultLogo = "/assets/logos/rong-pencil-banner.jpg";
const resolvedOgImage = (!ogImage || ogImage.includes("undefined") || ogImage.includes("null") || ogImage.trim() === "") ? defaultLogo : ogImage;

// Make the OG image URL absolute
const ogImageURL = new URL(resolvedOgImage, siteUrl).href;
const ogImageType = ogImageURL.toLowerCase().includes('.png') ? 'image/png' : 'image/jpeg';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- <link rel="icon" type="image/svg+xml" href="/favicon.ico" /> -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- SEO Meta Tags -->
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Rong Pencil Art Academy" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:site_name" content="Rong Pencil Art Academy" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL} />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WE7QRHXXF7"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-WE7QRHXXF7');
		</script>
	</head>
	<body class="bg-gray-50">
		<MainHeader client:load />
		<main class="min-h-screen">
			<slot />
		</main>
		<Footer />
	</body>
</html>
